{
  "name": "rokctapp_composer",
  "version": "1.0.0",
  "package_name": "customer",
  "description": "Configuration list of active SDKs for paas_customer",
  "sdks": [
    {
      "name": "base_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/base/dart",
      "ref": "main",
      "home_sdk": false,
      "_comment": "Shared kernel (replaces retired core_sdk); provides the app shell templates."
    },
    {
      "name": "marketplace_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/commerce",
      "path": "../commerce/marketplace/dart",
      "ref": "main",
      "home_sdk": true,
      "_comment": "Customer-persona marketplace UI; home SDK for paas_customer, parallel to merchants_sdk/delivery_sdk."
    },
    {
      "name": "auth_sdk",
      "enabled": true,
      "source": "git",
      "path": "../Users/auth/dart",
      "git": "https://github.com/RokctAI/Users",
      "ref": "main"
    },
    {
      "name": "users_sdk",
      "enabled": true,
      "source": "git",
      "path": "../Users/users/dart",
