{
  "name": "rokctapp_composer",
  "version": "1.0.0",
  "package_name": "betassist",
  "description": "Configuration list of active SDKs for the BetAssist sporting app",
  "sdks": [
    {
      "name": "betassist_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/BetAssist",
      "path": "../BetAssist/betassist_sdk/dart",
      "ref": "main",
      "home_sdk": true
    },
    {
      "name": "fav_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/fav/dart",
      "ref": "main"
    },
    {
      "name": "base_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/base/dart",
      "ref": "main",
      "_comment": "Shared kernel (replaces retired core_sdk); provides the app shell templates."
    },
    {
      "name": "auth_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/auth/dart",
      "ref": "main"
    },
    {
      "name": "users_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/users/dart",
      "ref": "main"
    },
    {
      "name": "wallet_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/wallet/dart",
      "ref": "main"
    },
    {
      "name": "comms_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/comms/dart",
      "ref": "main"
    },
    {
      "name": "processing_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/productivity",
      "path": "../productivity/processing/dart",
      "ref": "main"
    },
    {
      "name": "corporate_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/corporate",
      "path": "../corporate/corporate/dart",
      "ref": "main"
    },
    {
      "name": "hms_sdk",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/hardware",
      "path": "../hardware/hms/dart",
      "ref": "main",
      "sha256": "197261eff5adae8a5bcbb42ce2dd1f7b16ad15716c4ff4268f9b9a77b3e9517c",
      "_comment": "Huawei Mobile Services support, built like desktop_sdk (SDK module, not productFlavors). Dart-side: DeviceServices ({gms, hms, neither} detection, cached, fail-open to gms) and an order-30 boot hook that, ONLY on GMS-free HMS-capable devices, boots Push Kit and registers the HMS push token through the same api.user.register_device_token gateway cmd the FCM token uses (provider 'hms'). No installs - the BUILD_HMS-gated AGConnect Gradle wiring lives statically in core's android template, default-off. Strict no-op in every plain GMS build."
    }
  ]
}
