{
  "name": "rcore_app",
  "version": "1.0.0",
  "description": "Frappe compose template for the startupos docker product (composes an app named rcore)",
  "modules": [
    {
      "name": "base",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/base/frappe",
      "ref": "main"
    },
    {
      "name": "auth",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/auth/frappe",
      "ref": "main"
    },
    {
      "name": "users",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/users/frappe",
      "ref": "main"
    },
    {
      "name": "subscriptions",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/subscriptions/frappe",
      "ref": "main"
    },
    {
      "name": "agent",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/agent/frappe",
      "ref": "main"
    },
    {
      "name": "pay",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/payments/frappe",
      "ref": "main"
    },
    {
      "name": "telemetry",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/telemetry/frappe",
      "ref": "main"
    },
    {
      "name": "productivity",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/productivity",
      "path": "../productivity/productivity/frappe",
      "ref": "main"
    },
    {
      "name": "comms",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/comms/frappe",
      "ref": "main"
    },
    {
      "name": "wallet",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/wallet/frappe",
      "ref": "main"
    },
    {
      "name": "studio",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/designer",
      "path": "../designer/studio/frappe",
      "ref": "main",
      "_comment": "Studio operations layer from the designer repo (design requests, design systems, campaigns, StartupOS document suites). Not part of rcore.json's current full composition; designer/studio/frappe/manifest.json declares name 'studio'."
    }
  ]
}
