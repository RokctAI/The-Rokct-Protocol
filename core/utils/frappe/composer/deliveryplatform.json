      "_sha256_comment": "SHA-256 of base/nextjs/install.py at core as bootstrapped; required by the composer's unpinned-installer gate. Update when upstream install.py changes."
    },
    {
      "name": "auth_sdk",
      "enabled": true,
      "source": "git",
