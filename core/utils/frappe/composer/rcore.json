{
  "name": "rcore_app",
  "version": "1.0.0",
  "description": "Frappe App Shell for Rcore Core Platform",
  "modules": [
    {
      "name": "base",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/base/frappe",
      "ref": "main",
      "_comment": "Added during composer schema migration: corporate/polaris/frappe's Loan and LoanTransfer doctypes have Link fields with options=\"Branch\", and Branch is only defined in this module (moved on disk to core/base/frappe from the retired core/core). Without composing it, polaris's doctype links would fail to resolve. manifest.json's own 'name' and its 137 hardcoded '{app_name}.core....' hook path segments were rewritten to 'base' in the same commit as this rename, so the module 'name' here and the manifest's identity now agree."
    },
    {
      "name": "auth",
      "enabled": true,
      "source": "git",
