{
  "name": "rcore_app",
  "version": "1.0.0",
  "description": "Frappe compose template for the supacharge docker product (composes an app named rcore)",
  "modules": [
    {
      "name": "base",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/base/frappe",
      "ref": "main"
    },
    {
      "name": "auth",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/auth/frappe",
      "ref": "main"
    },
    {
      "name": "users",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/users/frappe",
      "ref": "main"
    },
    {
      "name": "subscriptions",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/subscriptions/frappe",
      "ref": "main"
    },
    {
      "name": "agent",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/agent/frappe",
      "ref": "main"
    },
    {
      "name": "pay",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/payments/frappe",
      "ref": "main"
    },
    {
      "name": "telemetry",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/telemetry/frappe",
      "ref": "main"
    },
    {
      "name": "lms",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/lms/frappe",
      "ref": "main",
      "_comment": "Supacharge's home SDK (LMS domain: lessons, schedule, partner links)."
    },
    {
      "name": "comms",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/comms/frappe",
      "ref": "main"
    },
    {
      "name": "wallet",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/wallet/frappe",
      "ref": "main"
    }
  ]
}
