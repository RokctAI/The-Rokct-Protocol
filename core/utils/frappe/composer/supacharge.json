{
  "name": "rcore_app",
  "version": "1.0.0",
  "description": "Frappe compose template for the supacharge docker product (composes an app named rcore)",
  "modules": [
    {
      "name": "base",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/base/frappe",
      "ref": "main"
    },
    {
      "name": "auth",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/auth/frappe",
      "ref": "main"
    },
    {
      "name": "users",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/users/frappe",
      "ref": "main"
    },
    {
      "name": "subscriptions",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/subscriptions/frappe",
      "ref": "d549e49345ddac463636da0ccb59395c1c5eb315"
    },
    {
      "name": "agent",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/agent/frappe",
      "ref": "d549e49345ddac463636da0ccb59395c1c5eb315"
    },
    {
      "name": "gateways",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/gateways/frappe",
      "ref": "main",
      "_comment": "Replaces the retired 'pay' entry (../pay/payments/frappe no longer carries a frappe module or manifest.json): pay's payments/frappe content moved into the gateways and wallet modules, so this template mirrors rcore.json's wallet+gateways pair."
    },
    {
      "name": "telemetry",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/telemetry/frappe",
      "ref": "main"
    },
    {
      "name": "lms",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/lms/frappe",
      "ref": "d549e49345ddac463636da0ccb59395c1c5eb315",
      "_comment": "Supacharge's home SDK (LMS domain: lessons, schedule, partner links)."
    },
    {
      "name": "replay",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/replay/frappe",
      "ref": "d549e49345ddac463636da0ccb59395c1c5eb315",
      "_comment": "Supacharge's session-replay SDK (Replay Session schedule + decision #8 release-asset pipeline: fetch/cache/serve, warm + evict). Composed beside lms, which its serving gates resolve into."
    },
    {
      "name": "comms",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/comms/frappe",
      "ref": "main"
    },
    {
      "name": "wallet",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/wallet/frappe",
      "ref": "main"
    }
  ]
}
