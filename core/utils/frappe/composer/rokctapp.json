{
  "name": "rcore_app",
  "version": "1.0.0",
  "description": "Frappe compose template for the rokctapp docker product (composes an app named rcore)",
  "_comment": "The erp SDK joins this template when the erpnext fork lands (tracked in a separate thread).",
  "modules": [
    {
      "name": "base",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/base/frappe",
      "ref": "main"
    },
    {
      "name": "auth",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/auth/frappe",
      "ref": "main"
    },
    {
      "name": "users",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/Users",
      "path": "../Users/users/frappe",
      "ref": "main"
    },
    {
      "name": "subscriptions",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/agent",
      "path": "../agent/subscriptions/frappe",
      "ref": "main"
    },
    {
      "name": "pay",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/payments/frappe",
      "ref": "main"
    },
    {
      "name": "telemetry",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/telemetry/frappe",
      "ref": "main"
    },
    {
      "name": "comms",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/core",
      "path": "../core/comms/frappe",
      "ref": "main"
    },
    {
      "name": "wallet",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/pay",
      "path": "../pay/wallet/frappe",
      "ref": "main"
    },
    {
      "name": "crm",
      "enabled": true,
      "source": "git",
      "git": "https://github.com/RokctAI/productivity",
      "path": "../productivity/crm/frappe",
      "ref": "main",
      "_comment": "Core CRM slice (leads, deals, contacts, organizations, notes, tasks, call logs, statuses) ported from Frappenize/crm (frappe/crm fork) into the productivity SDK. Composing this module replaces installing the standalone frappe/crm app — a site must NOT have frappe/crm installed alongside rcore, since the doctype names (CRM Lead, CRM Deal, ...) are intentionally identical and would double-define. Existing sites need one 'bench execute rcore.patches.crm_seed_defaults.execute' to seed default statuses."
    }
  ]
}
